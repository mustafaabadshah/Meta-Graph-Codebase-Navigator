# ==============================================================================
# Meta-Graph Codebase Navigator Configuration
# ==============================================================================

# Neo4j Graph Database
# Options: bolt://localhost:7687 or neo4j+s://<aura-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Graph Storage Backend
# Options: "neo4j" or "networkx" (in-memory/persistence fallback)
# If set to "neo4j", the system attempts to connect to Neo4j. If unavailable,
# connection diagnostics are reported cleanly without crashing.
GRAPH_BACKEND=neo4j

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Server & Network Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_API_URL=http://127.0.0.1:8000

# Repository & Scanning Policy
DEFAULT_REPOSITORY_PATH=E:\MM Office\Agent Chess
MAX_REPOSITORY_FILES=1000
MAX_FILE_SIZE_BYTES=1048576

# Bounded Retrieval Limits
MAX_GRAPH_DEPTH=4
MAX_GRAPH_NODES=60
MAX_GRAPH_EDGES=120
QUERY_TIMEOUT_SECONDS=30

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
